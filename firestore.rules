rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada persona solo lee y escribe lo suyo.
    match /users/{uid}/products/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/meta/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Listas compartidas: cualquiera con el enlace las lee (el id es largo y no se puede adivinar
    // ni listar); solo su dueño puede crearlas, cambiarlas o borrarlas.
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;

      match /products/{pid} {
        allow get, list: if true;
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/shares/$(shareId)).data.owner == request.auth.uid;
      }
    }
  }
}
